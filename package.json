{
  "name": "kalpa-slideshow-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Kalpa slideshow generator with live OpenAI generation, real file ingestion, and PPTX export.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src tests --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.539.0",
    "mammoth": "^1.11.0",
    "next": "^15.0.0",
    "openai": "^5.12.2",
    "pdf-parse": "^1.1.1",
    "pptxgenjs": "^3.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.2.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.0.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "prisma": "^6.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
